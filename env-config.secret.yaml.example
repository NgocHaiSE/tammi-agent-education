# ===================================================================
# Environment Configuration Secrets - Tammi Education Agent
# ===================================================================
# This is an EXAMPLE template for env-config.secret.yaml
# 
# Copy this file to env-config.secret.yaml and fill in your actual values.
# DO NOT commit env-config.secret.yaml to version control!
#
# Usage:
#   cp env-config.secret.yaml.example env-config.secret.yaml
#   # Edit env-config.secret.yaml with your actual secret values
#   python scripts/env_deploy.py validate
#   python scripts/env_deploy.py sync-all
# ===================================================================

version: "1.0"

# Secret values (marked as secret: true in env-config.yaml)
secrets:
  # ===================================================================
  # Vector Database Secrets
  # ===================================================================
  
  # Qdrant API Key (if using Qdrant Cloud)
  QDRANT_API_KEY: "your_qdrant_api_key_here"
  
  # Elasticsearch credentials (if using Elasticsearch)
  ELASTICSEARCH_API_KEY: "your_elasticsearch_api_key_here"
  ELASTICSEARCH_PASSWORD: "your_elasticsearch_password_here"
  
  # ===================================================================
  # Embedding Service Secrets
  # ===================================================================
  
  # Azure Text-3 Embedding (if using Azure)
  ENDPOINT_TEXT3_EMBEDDING: "https://your-azure-endpoint.openai.azure.com/"
  API_KEY_TEXT3_EMBEDDING: "your_azure_embedding_api_key_here"
  
  # ===================================================================
  # LLM Provider Secrets
  # ===================================================================
  
  # OpenAI API Key (if using OpenAI)
  OPENAI_API_KEY: "sk-your_openai_api_key_here"
  
  # Azure OpenAI (if using Azure OpenAI)
  AZURE_OPENAI_API_KEY: "your_azure_openai_api_key_here"
  
  # OpenRouter (if using OpenRouter)
  OPENROUTER_API_KEY: "your_openrouter_api_key_here"
  
  # Google Gemini API Key (if using Google Gemini)
  GOOGLE_API_KEY: "your_google_gemini_api_key_here"
  
  # Custom OpenAI-compatible endpoint (if using custom endpoint)
  CUSTOM_OPENAI_API_KEY: "your_custom_openai_api_key_here"

# ===================================================================
# Optional: Non-secret values that override env-config.yaml defaults
# ===================================================================
# Use this section to override default values in env-config.yaml
# without modifying the main configuration file.
#
# Example:
# values:
#   LLM_MODEL: "gpt-4o"  # Override default model
#   LOG_LEVEL: "DEBUG"   # Override log level
#   QDRANT_URL: "http://my-qdrant-server:6333"  # Override Qdrant URL
# ===================================================================
values: {}

# ===================================================================
# Instructions for setup:
# ===================================================================
# 
# 1. Copy this file:
#    cp env-config.secret.yaml.example env-config.secret.yaml
#
# 2. Edit env-config.secret.yaml and replace all placeholder values
#    with your actual credentials
#
# 3. Validate your configuration:
#    python scripts/env_deploy.py validate
#
# 4. Test locally:
#    python scripts/env_deploy.py test-local
#
# 5. Setup GitHub Secrets (for CI/CD):
#    python scripts/setup_github_secrets_from_env.py --yaml-config
#
# 6. Generate Kubernetes ConfigMap (for deployment):
#    python scripts/env_deploy.py sync-k8s
#
# ===================================================================
# Security Notes:
# ===================================================================
# 
# - NEVER commit env-config.secret.yaml to version control
# - Add env-config.secret.yaml to .gitignore
# - Keep backup of secrets in a secure password manager
# - Rotate secrets regularly
# - Use different secrets for different environments
#   (development, staging, production)
# - For production, consider using:
#   * GitHub Secrets for CI/CD
#   * Kubernetes Secrets or external secret management
#   * Azure Key Vault, AWS Secrets Manager, or HashiCorp Vault
#
# ===================================================================
