# ---- Python project (.gitignore) — PyCharm / VS Code friendly ----

# Byte-compiled / optimized / compiled files
__pycache__/
*.py[cod]
*$py.class

# C/C++/Cython extensions
*.so
*.pyd
*.dll

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
pip-wheel-metadata/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log

# Type checker / static analysis
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.pyright/
ruff_cache/

# Cython debug symbols
cython_debug/

# Jupyter Notebook
.ipynb_checkpoints

# Virtual environments
backup/.env
backup/.env.example
.venv
.venv*/
venv/
ENV/
env/
env.bak/
venv.bak/
.python-version
__pypackages__/

# IDE settings
# PyCharm / IntelliJ
.idea/
# VS Code (ignore all, but allow sharing of common project configs if needed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# OS-specific files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Generated protobuf files (regenerated during build)
*_pb2.py
*_pb2.pyi
*_pb2_grpc.py

# Logs and temp files
*.log
logs/
.tmp/
.tmp*/
tmp/
.temp/

# Docker/compose local overrides (optional)
# docker-compose.override.yml
# .docker/

# Local tooling caches
.sourcery/

# Environment configuration secrets
env-config.secret.yaml

# End of file
/old_code/
/.vscode/
/AITeam/TeamConversation/
/AITeam/TechLeadRequests/
/AITeam/SharedData/
/AITeam/Prompt/
/AITeam/

AITeam/
__pycache__/
/examples/
/deploy/
/.env
