# ============================================================================
# Multi-stage Dockerfile for Tammi Agent Education Service
# ============================================================================
# Production-ready image with:
#   - Python 3.12 for performance improvements
#   - Multi-stage build để giảm image size
#   - Supervisord cho dual protocol management (HTTP + gRPC)
#   - ENV-based configuration cho flexibility
#   - Non-root user cho security
#   - Health check built-in
# ============================================================================

# ============================================================================
# Stage 1: Builder - Compile dependencies into wheels for faster runtime install
# ============================================================================
FROM python:3.12-slim AS builder

WORKDIR /opt/build

# Install build dependencies for Python packages with C extensions
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        libssl-dev \
        libffi-dev \
        pkg-config \
        python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and build wheels
COPY requirements.txt /opt/build/requirements.txt
RUN python -m pip install --upgrade pip setuptools wheel
RUN python -m pip wheel --wheel-dir=/opt/build/wheels -r /opt/build/requirements.txt

# ============================================================================
# Stage 2: Runtime - Minimal production image
# ============================================================================
FROM python:3.12-slim

LABEL maintainer="Viettel AI Team"
LABEL description="Tammi Agent Education - Multi-provider LLM Agent with gRPC & HTTP interfaces"

WORKDIR /app

# ============================================================================
# Environment Variables - Production Configuration
# ============================================================================

# Python runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# Gunicorn/Uvicorn (LLM-friendly, conservative defaults)
# Leave GUNICORN_WORKERS blank to let entrypoint compute a safe default
ENV GUNICORN_WORKERS="" \
    GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker \
    GUNICORN_WORKER_CONNECTIONS=100 \
    GUNICORN_BACKLOG=1024

ENV GUNICORN_MAX_REQUESTS=500 \
    GUNICORN_MAX_REQUESTS_JITTER=50 \
    GUNICORN_TIMEOUT=120 \
    GUNICORN_GRACEFUL_TIMEOUT=30 \
    GUNICORN_KEEP_ALIVE=2

ENV GUNICORN_WORKER_TMP_DIR=/dev/shm \
    GUNICORN_PRELOAD=false

ENV GUNICORN_LOG_LEVEL=info \
    GUNICORN_ACCESS_LOG=- \
    GUNICORN_ERROR_LOG=-

ENV UVICORN_LOOP=uvloop \
    UVICORN_HTTP=httptools \
    UVICORN_INTERFACE=asgi3


# ============================================================================
# Install Runtime Dependencies
# ============================================================================

# Install runtime dependencies including supervisor for process management
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        supervisor \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies from wheels built in builder stage
# Also install gunicorn and uvicorn for production HTTP serving
COPY --from=builder /opt/build/wheels /wheels
RUN python -m pip install --no-cache-dir \
    /wheels/* \
    gunicorn \
    "uvicorn[standard]" \
    && rm -rf /wheels

# ============================================================================
# Application Setup
# ============================================================================

# Create non-root user for security best practices
RUN groupadd --system app && \
    useradd --system --gid app --home /app --shell /sbin/nologin app && \
    mkdir -p /app && \
    chown -R app:app /app

# Copy proto files first (needed for stub generation)
COPY --chown=app:app agent/proto/*.proto /app/agent/proto/
COPY --chown=app:app agent/proto/generate_stubs.py /app/agent/proto/
COPY --chown=app:app agent/proto/__init__.py /app/agent/proto/
COPY --chown=app:app agent/__init__.py /app/agent/

# Generate proto stubs during build
# This ensures stubs are always fresh and match the proto definitions
RUN python /app/agent/proto/generate_stubs.py && \
    echo "Proto stubs generated successfully" || \
    (echo "Failed to generate proto stubs" && exit 1)

# Copy rest of service code (only what's needed, see .dockerignore)
COPY --chown=app:app agent/ /app/agent/

# Copy supervisord configuration
COPY --chown=app:app supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Switch to non-root user
USER app

# ============================================================================
# Entrypoint
# ============================================================================
# Production: Run supervisord to manage both HTTP and gRPC servers
# Local testing: Use `python agent/entrypoint/run.py` instead
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
